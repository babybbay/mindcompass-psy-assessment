# Documentation only. Vars and D1 bindings are provided by the deployment platform.
# Do not use NEXT_PUBLIC_* for private settings.
APP_ORIGIN=https://your-existing-site.example
# Server-side admin password (secret). Set a strong random value; /admin is locked until configured.
ADMIN_PASSWORD=
# Public research contact shown on the privacy and feedback pages.
RESEARCH_CONTACT_EMAIL=research-contact@example.com
